{
  "mcpServers": {
    "usb-webcam": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "usb-webcam-mcp", "usb-webcam-mcp"],
      "env": {}
    },
    "wifi-cam": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "wifi-cam-mcp", "wifi-cam-mcp"],
      "env": {}
    },
    "memory": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "memory-mcp", "--extra", "chroma", "memory-mcp"],
      "env": {
        "MEMORY_BACKEND": "chroma"
      }
    },
    "system-temperature": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "system-temperature-mcp", "system-temperature-mcp"],
      "env": {}
    },
    "local-inference": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "local-inference-mcp", "local-inference-mcp"],
      "env": {
        "SANPOLOID_LOCAL_LLM_BASE_URL": "http://127.0.0.1:1234/v1"
      }
    },
    "elevenlabs-t2s": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "elevenlabs-t2s-mcp", "elevenlabs-t2s"],
      "env": {
        "GO2RTC_URL": "http://127.0.0.1:1984",
        "GO2RTC_STREAM": "tapo_cam",
        "ELEVENLABS_PLAYBACK": "none"
      }
    }
  }
}
