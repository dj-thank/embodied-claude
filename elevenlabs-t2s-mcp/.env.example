# Required
ELEVENLABS_API_KEY=your-api-key

# Optional defaults
ELEVENLABS_VOICE_ID=uYp2UUDeS74htH10iY2e
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_PLAY_AUDIO=true
ELEVENLABS_SAVE_DIR=/tmp/elevenlabs-t2s

# Optional playback routing (useful on WSL)
# auto | paplay | elevenlabs | ffplay
ELEVENLABS_PLAYBACK=auto
# Set PulseAudio sink id (e.g., 1) when using paplay/WSL
ELEVENLABS_PULSE_SINK=
# Explicit PulseAudio server (WSLg default shown)
ELEVENLABS_PULSE_SERVER=unix:/mnt/wslg/PulseServer

# Optional go2rtc audio backchannel
# Managed auto-start accepts only http://localhost:1984 or another loopback spelling.
# GO2RTC_URL=http://localhost:1984
# Optional Basic auth for an operator-managed API. Set both or neither.
# Managed auto-start generates a separate random pair for every launch.
# GO2RTC_API_USERNAME=
# GO2RTC_API_PASSWORD=
# GO2RTC_STREAM=tapo_cam
# GO2RTC_AUTO_START=true
# GO2RTC_CAMERA_HOST=192.168.1.xxx
# GO2RTC_CAMERA_USERNAME=your-tapo-username
# GO2RTC_CAMERA_PASSWORD=your-tapo-password
# GO2RTC_FFMPEG=ffmpeg
# Leave empty to use the managed, version-and-digest-pinned go2rtc binary.
# Set an existing path to use an operator-managed binary instead.
# GO2RTC_BIN=
# A custom config is operator-managed. Set GO2RTC_AUTO_START=false when connecting
# to an independently managed service; its bind/auth/credential policy is not rewritten.
# GO2RTC_CONFIG=
