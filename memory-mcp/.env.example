# Memory MCP Server Configuration

# Path to store ChromaDB data (default: ~/.claude/memories/chroma)
# MEMORY_DB_PATH=/home/user/.claude/memories/chroma

# Collection name for memories (default: claude_memories)
# MEMORY_COLLECTION_NAME=claude_memories

# Destructive record deletion is disabled unless explicitly enabled.
MEMORY_DELETION_ENABLED=false

# One-time prepare_forget token lifetime in seconds (clamped to 30-3600).
MEMORY_DELETION_TOKEN_TTL_SECONDS=300
